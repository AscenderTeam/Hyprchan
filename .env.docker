# Required OpenAI credentials
OPENAI_OAUTH_TOKEN=replace_with_openai_bearer_token
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=30

# HyprMemory defaults for pgvector + OpenAI embeddings
HYPRMEMORY_VECTOR_DIM=1536
HYPRMEMORY_EMBEDDINGS=openai
HYPRMEMORY_VECTOR_STORE=pgvector

# Optional perception toggles in containers
WEBCAM_VISION_ENABLED=false
MULTIMODAL_SNAPSHOT_ENABLED=false
SPEECH_PERCEPTION_ENABLED=false
