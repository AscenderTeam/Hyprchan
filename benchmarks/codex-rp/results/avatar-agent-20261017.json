  "scripts": [
    {
      "id": "hoodie_huff",
      "code": "import math\nfrom hyprchan.core.animations.avatar3d.emote_api import animate, ease\n\ndef pose(t):\n    # anticipation, puff, head tilt, then a gentle smile\n    if t < 0.18:\n        u = ease(t / 0.18)\n        return {\n            \"expressions\": {\"eyes_wide\": 0.15 + 0.35*u, \"mouth_small\": 0.2*u, \"puff\": 0},\n            \"bones\": {\"head\": [0, 0, -4*u], \"neck\": [0, 0, -2*u]}\n        }\n    if t < 0.62:\n        u = ease((t - 0.18) / 0.44)\n        return {\n            \"expressions\": {\"eyes_wide\": 0.5, \"puff\": 0.95, \"mouth_small\": 0, \"smile\": 0},\n            \"bones\": {\"head\": [0, 0, -4 - 8*u], \"neck\": [0, 0, -2 - 3*u]}\n        }\n    u = ease((t - 0.62) / 0.38)\n    return {\n        \"expressions\": {\"eyes_wide\": 0.5*(1-u), \"puff\": 0.95*(1-u), \"mouth_small\": 0.05, \"smile\": 0.75*u, \"joy\": 0.15*u},\n        \"bones\": {\"head\": [0, 0, -12*(1-u)], \"neck\": [0, 0, -5*(1-u)]}\n    }\n\nanimate(4.0, pose)\n"
    }
