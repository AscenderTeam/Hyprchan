    {
      "id": "face_wave_test",
      "code": "from math import sin\nfrom hyprchan.core.animations.avatar3d.emote_api import animate, ease, hand_target\n\ndef pose(t):\n    w = ease(min(t/.22, (1-t)/.24))\n    return {\n        'expressions': {'smile': .45*w},\n        'hands': {'right': hand_target([.018*sin(t*20), -.025, .14],\n                    shape='open', roll=16*sin(t*32), weight=w)}\n    }\n\nanimate(4, pose)\n"
    },
    {
      "id": "face_peace_test",
      "code": "from hyprchan.core.animations.avatar3d.emote_api import animate, ease, hand_target\n\ndef pose(t):\n    w = ease(min(t/.22, (1-t)/.26))\n    return {\n        'expressions': {'smile': .5*w, 'blush': .2*w},\n        'bones': {'head': [0, 0, 8*w]},\n        'hands': {'right': hand_target([-.025, -.025, .14],\n                    shape='peace', roll=-8, weight=w)}\n    }\n\nanimate(4, pose)\n"
    }
