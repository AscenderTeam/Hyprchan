#!/usr/bin/python
"""Open the desktop companion without keeping a terminal alive."""
import json
import os
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
GUI = ["/usr/bin/python", str(ROOT / "scripts/desktop_codex_rp.py")]
UNIT = "hyprchan-codex-preview.service"


def main():
    if any(option in sys.argv[1:] for option in ["--control", "--help", "-h"]):
        return subprocess.call([*GUI, *sys.argv[1:]])
    env = os.environ.copy()
    settings = Path(env.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "hyprchan/preview-launch.json"
    if settings.exists():
        values = json.loads(settings.read_text())
        if not isinstance(values, dict) or any(not isinstance(key, str) or not isinstance(value, str)
                                               for key, value in values.items()):
            raise ValueError(f"Expected environment names and string values in {settings}")
        for key, value in values.items():
            if key.startswith("HYPRCHAN_") or key in {"WEBCAM_DEVICE_INDEX", "MULTIMODAL_SNAPSHOT_INTERVAL_SEC"}:
                env.setdefault(key, value)
    codex = Path.home() / ".local/bin/codex"
    if codex.exists():
        env.setdefault("HYPRCHAN_CODEX_BIN", str(codex))
    # The GUI owns the instance lock. Reopening should present it, not restart it.
    opened = subprocess.run([*GUI, "--control", '{"type":"present"}'], env=env,
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if opened.returncode == 0:
        return 0
    # A second click while the first instance is warming needs no new service.
    if subprocess.run(["systemctl", "--user", "is-active", "--quiet", UNIT]).returncode == 0:
        return 0
    command = ["systemd-run", "--user", "--collect", "--quiet", "--service-type=exec",
               "--expand-environment=no", f"--unit={UNIT}",
               f"--working-directory={ROOT}"]
    session_keys = {"PATH", "DISPLAY", "WAYLAND_DISPLAY", "XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS",
                    "HYPRLAND_INSTANCE_SIGNATURE", "XDG_CURRENT_DESKTOP", "XDG_SESSION_TYPE",
                    "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_CACHE_HOME", "XDG_ACTIVATION_TOKEN",
                    "LANG", "LC_ALL", "MULTIMODAL_SNAPSHOT_INTERVAL_SEC", "WEBCAM_DEVICE_INDEX"}
    for key, value in env.items():
        if key in session_keys or key.startswith("HYPRCHAN_"):
            command.append(f"--setenv={key}={value}")
    return subprocess.call([*command, *GUI, *sys.argv[1:]], env=env)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError) as error:
        print(f"Could not start Hyprchan: {error}", file=sys.stderr)
        raise SystemExit(1)
